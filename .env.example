# Local dev / single machine (SQLite file):
DATABASE_URL="./data/app.db"

# Production / cross-device sync (Postgres, e.g. Neon, Supabase, Railway):
# 1. Set DATABASE_URL to your Postgres connection string:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# 2. In src/lib/db/index.ts, switch the driver from node:sqlite to
#    drizzle-orm/node-postgres (see comment block at the top of that file).
