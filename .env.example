# Local dev, single machine, zero config (SQLite file):
DATABASE_URL="./data/app.db"

# Shared / production (Turso — hosted, SQLite-compatible, so no schema or
# driver changes needed beyond what's already in src/lib/db/index.ts):
# 1. Create a database at https://turso.tech (or `turso db create` via their CLI).
# 2. Get its URL and an auth token (dashboard: Databases > your db > Connect,
#    or `turso db show <name> --url` / `turso db tokens create <name>`).
# 3. Set both of these (leave DATABASE_URL unset, or it's ignored):
# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="ey..."
# 4. npm run db:push   (creates the schema in Turso)
#
# Any machine/deploy with the same two vars shares the same live database —
# this is what makes writes work on Netlify (its function filesystem is
# read-only, so a local SQLite file can't be written to once deployed).
