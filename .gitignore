# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local SQLite database + generated report/proposal PDFs (not source data —
# real client data, and PDFs regenerate from the code + DB + templates)
/data/app.db
/data/app.db-*
/data/reports/
/data/proposals/

# backup/restore-point zips (large, timestamped snapshots — not source)
/backups/

# one-off Turso migration input (real client PII + a live API key pulled from
# production — never source, never committed; see scripts/migrate-turso-import.ts)
/scripts/migration-data/

# one-off delivery/output files from working with Claude (not source)
/Claude outputs/
pitch-icons.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
